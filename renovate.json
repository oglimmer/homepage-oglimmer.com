{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":disableDependencyDashboard"
  ],
  "ignoreTests": true,
  "rebaseWhen": "auto",
  "platformAutomerge": true,
  "schedule": [
    "before 5am on monday"
  ],
  "semanticCommits": "enabled",
  "automergeType": "pr",
  "packageRules": [
    {
      "description": "Automerge non-major updates with stabilization period",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Automerge Nuxt ecosystem packages (minor/patch)",
      "groupName": "Nuxt ecosystem",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "matchPackageNames": [
        "/^nuxt/",
        "/^@nuxt//",
        "/^@nuxtjs//"
      ]
    },
    {
      "description": "Automerge dev dependencies (minor/patch) faster",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Group ESLint packages",
      "groupName": "ESLint",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "matchPackageNames": [
        "/^eslint/",
        "/^@eslint//"
      ]
    },
    {
      "description": "Group Tailwind CSS packages",
      "groupName": "Tailwind CSS",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "matchPackageNames": [
        "/^tailwindcss/",
        "/^@tailwindcss//"
      ]
    },
    {
      "description": "Automerge patch updates for major dependencies",
      "matchUpdateTypes": [
        "patch"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "automerge": true,
      "minimumReleaseAge": "2 days"
    },
    {
      "description": "Pin digest updates",
      "matchUpdateTypes": [
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Major updates - require manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    }
  ]
}
